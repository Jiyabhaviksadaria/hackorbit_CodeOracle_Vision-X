# ============================================================
# CodeOracle Backend — Environment Template
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── AI Provider (pick one) ───────────────────────────────────
AI_PROVIDER=groq          # options: ollama | groq | gemini | openai

# Ollama (local, default for dev)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Groq (free tier, fast — ACTIVE provider for this project)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (free tier)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-pro

# OpenAI (paid)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4

# ── Application Limits ───────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
MAX_LOC=10000
STAGE_TIMEOUT_SECONDS=300

# ── Storage ──────────────────────────────────────────────────
TEMP_WORKSPACE_ROOT=./workspaces

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
RELOAD=true

# ── Feature Flags ────────────────────────────────────────────
ENABLE_JAVASCRIPT_PARSING=true
ENABLE_TEST_GENERATION=true
ENABLE_REFACTORING=true
ENABLE_COVERAGE_REPORTING=true
